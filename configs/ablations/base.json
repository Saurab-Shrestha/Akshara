{
  "_comment": "Ablation proxy (Smol Training Playbook: change one thing at a time, matched params, decay every run). 768 wide x 16 layers hybrid 3:1 \u2248 148M params (110M non-embedding), same tokenizer/data/recipe as the 443M run. 16x1024x6 = 98k tokens/step x 10.2k steps \u2248 1B tokens each, WSD with its own decay so final dev losses are comparable. ~2.5-7 A100-hours per run.",
  "vocab_size": 49152,
  "tokenizer": "tokenizer/akshara-bpe",
  "n_embed": 768,
  "n_heads": 12,
  "n_kv_heads": 4,
  "n_layers": 16,
  "attn_every": 4,
  "max_seq_len": 1024,
  "qk_norm": true,
  "device": "cuda",
  "use_amp": true,
  "amp_dtype": "bf16",
  "use_fla": true,
  "compile": false,
  "use_gradient_checkpointing": false,
  "seed": 42,
  "batch_size": 16,
  "grad_accum": 6,
  "train_steps": 10200,
  "warmup_steps": 200,
  "schedule": "wsd",
  "decay_frac": 0.15,
  "anneal_path": null,
  "optimizer": "muon",
  "lr": 0.0004,
  "min_lr": 4e-05,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "no_wd_embed": true,
  "z_loss": 1e-05,
  "ce_chunk": 8192,
  "eval_steps": 500,
  "eval_iters": 100,
  "save_every": 500,
  "train_path": "data/corpus_v6/train.bin",
  "dev_path": "data/corpus_v6/val.bin",
  "hf_repo": "Saurab0/akshara-ablations"
}
